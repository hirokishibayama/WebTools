# Site (本番では Vercel の本番URLに変更)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense
# 1) https://www.google.com/adsense/ でサイトを追加して審査
# 2) 発行された ca-pub-XXXX を設定
# 3) 広告ユニット作成後、各 SLOT ID を設定（未設定でも Auto ads 利用可）
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=1234567890

# AI（サーバー側のみ。Vercel Environment Variables に設定）
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# コスト制御（推奨）
# AI_OPENAI_FALLBACK=false
# AI_DAILY_LIMIT_PER_IP=10
# AI_HOURLY_LIMIT_PER_IP=5
# AI_MAX_CHARS=2000
# AI_ENABLED=true
